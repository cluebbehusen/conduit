# SwiftFormat configuration

# Format options
--indent 4
--indentcase false
--trimwhitespace always
--voidtype void
--semicolons never
--commas inline
--stripunusedargs closure-only
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced

# Rules to enable
--enable isEmpty
--enable redundantInit
--enable sortImports
--enable trailingSpace
--enable wrapSingleLineComments

# Rules to disable
--disable redundantSelf
--disable wrapPropertyBodies
--enable trailingCommas

# Modifier order (SwiftLint expects nonisolated before private)
--modifier-order nonisolated,override,acl,setteracl,dynamic,mutators,lazy,final,required,convenience,typemethods,owned

# File options
--exclude .build,DerivedData
